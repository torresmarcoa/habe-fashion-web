node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
next-env.d.ts

# Production
build/
dist/

# Testing
coverage/

# Environment variables
# Secrets-bearing files stay out of source control.
# `.env.example` is tracked because it documents variable names only.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Vercel
.vercel

# Third-party skill files that the skills CLI regenerates on every
# `skills check` or `skills update`. They document the upstream skill, not
# this project, so they are not versioned. The skill's SKILL.md, rules, and
# metadata remain tracked.
.agents/skills/*/AGENTS.md
.agents/skills/*/README.md