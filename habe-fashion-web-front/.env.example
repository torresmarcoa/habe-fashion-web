# Public runtime configuration for the Habe frontend.
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# ignored by Git and must never be committed (REQ-SEC-001, REQ-SEC-002).
#
# Every `NEXT_PUBLIC_*` value is inlined into the client bundle at build time
# and is therefore public. Only use it for values safe to expose publicly
# (REQ-SEC-003). Never put an API secret, token, or password here.

# Designer's WhatsApp business number, in international format.
# Digits only, no "+", spaces, or dashes. Include the country code.
# Example: 5215555555555
# Leave empty to build the site without a contact link (REQ-CONTACT-005).
NEXT_PUBLIC_WHATSAPP_PHONE=

# Public social profile URLs.
# Leave empty and the footer shows the platform name in a non-interactive slot
# (REQ-SOCIAL-003). Do not invent these values.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Handles displayed alongside each platform in the footer.
# The leading "@" is added automatically for Instagram.
# Leave empty to show the platform name instead.
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_FACEBOOK_HANDLE=
NEXT_PUBLIC_YOUTUBE_HANDLE=

# Cloudinary cloud name, taken from the delivery URL of any uploaded asset.
# This project's cloud name is: jtkidlbp
# Delivery URLs are built as:
#   https://res.cloudinary.com/<CLOUD_NAME>/image/upload/f_auto,q_auto,w_<width>/<PUBLIC_ID>
# See docs/adr/ADR-003-cloudinary-media.md.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=jtkidlbp