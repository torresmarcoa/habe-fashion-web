# Public runtime configuration for the Habe frontend.
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# ignored by Git and must never be committed (REQ-SEC-001, REQ-SEC-002).
#
# Every `NEXT_PUBLIC_*` value is inlined into the client bundle at build time
# and is therefore public. Only use it for values safe to expose publicly
# (REQ-SEC-003). Never put an API secret, token, or password here.

# Designer's WhatsApp business number, in international format.
# Digits only, no "+", spaces, or dashes. Include the country code.
# Example: 5215555555555
# Leave empty to build the site without a contact link (REQ-CONTACT-005).
NEXT_PUBLIC_WHATSAPP_PHONE=

# Public social profile URLs.
# Leave empty to omit the profile from the footer (REQ-SOCIAL-003).
# Do not invent these values; add them when the designer supplies them.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=